{
  "name": "@dcc/desktop",
  "productName": "Dynasty Command Center",
  "version": "0.58.0",
  "private": true,
  "description": "Dynasty Command Center — Windows workspace and save agent.",
  "author": {
    "name": "Dynasty Command Center"
  },
  "main": "dist/main/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "node dev.mjs",
    "build": "tsc --noEmit && vite build && node build-electron.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir --publish never",
    "check:assets": "esbuild electron/gameAssets.ts --bundle --platform=node --format=cjs --outfile=.tmp-assets.cjs --log-level=error && node check-assets.cjs ./.tmp-assets.cjs",
    "check:save": "esbuild electron/saveAnalysis.ts --bundle --platform=node --format=cjs --outfile=.tmp-save.cjs --log-level=error && node check-save.cjs ./.tmp-save.cjs",
    "check:write": "esbuild electron/saveWrite.ts --bundle --platform=node --format=cjs --outfile=.tmp-write.cjs --log-level=error && esbuild electron/saveAnalysis.ts --bundle --platform=node --format=cjs --outfile=.tmp-save.cjs --log-level=error && node check-write.cjs ./.tmp-write.cjs ./.tmp-save.cjs",
    "check:relay": "esbuild electron/relay.ts --bundle --platform=node --format=cjs --outfile=.tmp-relay.cjs --external:electron --log-level=error && node check-relay.cjs ./.tmp-relay.cjs",
    "check:snapshot": "esbuild electron/snapshot.ts --bundle --platform=node --format=cjs --outfile=.tmp-snapshot.cjs --log-level=error && node check-snapshot.cjs ./.tmp-snapshot.cjs",
    "check:depth": "esbuild electron/saveAnalysis.ts --bundle --platform=node --format=cjs --outfile=.tmp-depth.cjs --log-level=error && esbuild electron/saveWrite.ts --bundle --platform=node --format=cjs --outfile=.tmp-depthw.cjs --log-level=error && node check-depth.cjs ./.tmp-depth.cjs ./.tmp-depthw.cjs",
    "check:transfers": "esbuild electron/transfers.ts --bundle --platform=node --format=cjs --outfile=.tmp-transfers.cjs --log-level=error && node check-transfers.cjs ./.tmp-transfers.cjs",
    "check:tamper": "esbuild electron/tamper.ts --bundle --platform=node --format=cjs --outfile=.tmp-tamper.cjs --external:electron --log-level=error && node check-tamper.cjs ./.tmp-tamper.cjs",
    "check:schema": "esbuild electron/schema.ts --bundle --platform=node --format=cjs --outfile=.tmp-schema.cjs --log-level=error && node check-schema.cjs ./.tmp-schema.cjs ../../shared/data/schema-index.json.gz",
    "check:league": "esbuild electron/league.ts --bundle --platform=node --format=cjs --outfile=.tmp-league.cjs --log-level=error && node check-league.cjs ./.tmp-league.cjs",
    "check:pack": "esbuild electron/artPack.ts --bundle --platform=node --format=cjs --outfile=.tmp-pack.cjs --log-level=error && node check-pack.cjs ./.tmp-pack.cjs",
    "check:classes": "esbuild electron/recruiting.ts --bundle --platform=node --format=cjs --outfile=.tmp-rec.cjs --log-level=error && node check-classes.cjs ./.tmp-rec.cjs"
  },
  "dependencies": {
    "electron-updater": "6.3.9"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "^37.10.3",
    "electron-builder": "^26.0.12",
    "esbuild": "0.24.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "5.7.2",
    "vite": "6.0.7"
  }
}
